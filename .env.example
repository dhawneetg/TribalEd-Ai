# Sarthi Environment Configuration

# Application
APP_ENV=development
SECRET_KEY=sih2026_sarthi_super_secret_jwt_key
PORT=8000

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./sarthi.db
# DATABASE_URL=postgresql://sarthi:sarthi_pass@localhost:5432/sarthi_db

# Redis Broker
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sarthi-documents

# DigiLocker / Aadhaar Mock
DIGILOCKER_MOCK_ENABLED=true
PFMS_MOCK_ENABLED=true

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
